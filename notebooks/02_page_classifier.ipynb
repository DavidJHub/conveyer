    "### 5.1 Which features carry weight\n",
    "\n",
    "Feature hashing has no stored vocabulary, but every feature *string* is\n",
    "reconstructible — so we hash the training vocabulary back and read each\n",
    "feature's learned coefficient per class. (Hash collisions can blend a pair of\n",
    "features; with 65k dims and a few thousand features they are rare.) This is\n",
    "the direct answer to *\"which features seem important\"*:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "98391c33",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-29T04:41:40.519621Z",
     "iopub.status.busy": "2026-07-29T04:41:40.519419Z",
     "iopub.status.idle": "2026-07-29T04:41:41.155594Z",
     "shell.execute_reply": "2026-07-29T04:41:41.154358Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "675 distinct features hashed into 65536 dims\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1300x620 with 6 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "from conveyer.scraping.model import _hash_feature\n",
    "\n",
    "X_feats, y = build_training_samples()          # same seed as autotrain\n",
    "vocab = sorted({f for feats in X_feats for f in feats})\n",
    "rows = []\n",
    "for f in vocab:\n",
    "    idx, sign = _hash_feature(f, model.dim)\n",
    "    for ci, cls in enumerate(model.classes):\n",
    "        rows.append((cls, f, float(sign * model.coef[ci, idx])))\n",
    "W = pd.DataFrame(rows, columns=[\"subtype\", \"feature\", \"weight\"])\n",
    "print(f\"{len(vocab)} distinct features hashed into {model.dim} dims\")\n",
    "\n",
    "show = [\"pdp\", \"cart\", \"serp\", \"tool\", \"article\", \"marketplace\"]\n",
    "fig, axes = plt.subplots(2, 3, figsize=(13, 6.2))\n",
    "for ax, cls in zip(axes.ravel(), show):\n",
    "    top = W[W.subtype == cls].nlargest(7, \"weight\").sort_values(\"weight\")\n",
    "    ax.barh(top.feature, top.weight, color=HUE, height=0.62)\n",
    "    ax.set_title(f\"top features -> {cls}\", fontsize=10.5, color=INK, loc=\"left\")\n",
    "    ax.tick_params(labelsize=8.5, colors=INK, length=0)\n",
    "    for s in (\"top\", \"right\", \"left\", \"bottom\"):\n",
    "        ax.spines[s].set_visible(False)\n",
    "plt.tight_layout(); plt.show()"
   ]
