    "    \"seller\": c.seller_type, \"funnel\": c.funnel_stage,\n",
    "    \"relevant\": c.is_study_relevant, \"signals\": \", \".join(c.signals),\n",
    "} for u in url_only for c in [classify_rule(extract_page(\"\", u), u, cfg)]])"
   ]
